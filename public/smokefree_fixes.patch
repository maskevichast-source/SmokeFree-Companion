+    }
+
+    // Step calculation to ensure optimal resolution (approx 16-24 data points)
+    const step = Math.max(1, Math.round(targetTotalDays / 20));
+    const dayPoints = new Set<number>();
+    dayPoints.add(0);
+    for (let d = step; d < targetTotalDays; d += step) {
