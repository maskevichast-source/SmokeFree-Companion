+{
+  "$schema": "https://railway.app/railway.schema.json",
+  "build": {
+    "builder": "NIXPACKS",
+    "watchPatterns": ["smokefree_bot/**"],
+    "buildCommand": "cd smokefree_bot && pip install --no-cache-dir -r requirements.txt"
